{
  "name": "yumeangelica.github.io",
  "version": "2.8.6",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "author": "yumeangelica",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run typecheck:ts7 && bun run typecheck:vue",
    "typecheck:ts7": "bun node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json && bun node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.node.json",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pr-description": "bun run scripts/pr-description.ts",
    "patch-push": "bun run scripts/release-push.ts patch",
    "minor-push": "bun run scripts/release-push.ts minor",
    "major-push": "bun run scripts/release-push.ts major",
    "deploy": "bun run typecheck && bun run build && bun run scripts/deploy-gh-pages.ts"
  },
  "dependencies": {
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@fontsource/comfortaa": "^5.3.0",
    "@types/bun": "^1.3.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "terser": "^5.50.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
